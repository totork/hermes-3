# 1D system with:
#  - no-flow boundary on lower Y
#  - sheath boundary on upper Y
#  - Evolving electron and ion species
#  - heat conduction
#  - Uniform source of heat and particles throughout domain
#  - Non-uniform grid, packed towards the target
#  - Recycling of ions as atoms
#  - Ionisation of neutrals as ions
#  - Charge exchange between neutrals and ions
#  - Feedback control of upstream density
#
#  Does not include recombination


nout = 100
timestep = 1e6 / nout


[mesh]

file = "../../../../../grids/slab_with_BC/MMS_straight_slab_8_128_4_True.fci.grid.nc"

[mesh:paralleltransform]
type = fci


[hermes]
# Evolve ion density, ion and electron pressure, then calculate force on ions due
# to electron pressure by using electron force balance.
components = (d+, e,
              sheath_boundary_fci, braginskii_collisions, 
              braginskii_ion_viscosity, braginskii_conduction, braginskii_heat_exchange)

Nnorm = 1e19
Bnorm = 1
Tnorm = 100

[solver]
type = pvode  # Backward Euler steady-state solver

mxstep = 50000

atol = 1e-7
rtol = 1e-5



[d+]  # Deuterium ions
type = (evolve_density, evolve_pressure, evolve_momentum, anomalous_diffusion_3d)

charge = 1
AA = 2

anomalous_D_par = 1e4
conduction_collisions_mode = braginskii
thermal_conduction = true  # in evolve_pressure


[Nd+]

function = 1

flux = 4e22

source = flux * gauss(y - pi, 0.25)


[Pd+]

function = (70.0 / `hermes`:Tnorm) * `Nd+`:function


heating = 8e5
T_source = heating / (`Nd+`:flux * 1.602e-19 * 1.5)
source =  `Nd+`:source * T_source * 1.602176634e-19

[NVd+]

function = 0


[e] # Electrons
type = quasineutral, evolve_pressure, zero_current

charge = -1
AA = 1/1836

thermal_conduction = true  # in evolve_pressure
conduction_collisions_mode = braginskii
[Pe]

function = `Pd+:function`  # Same as ion pressure initially

source = `Pd+:source`  # Same as ion pressure source

